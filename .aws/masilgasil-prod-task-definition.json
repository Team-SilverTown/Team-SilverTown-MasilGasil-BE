{
  "containerDefinitions": [
    {
      "name": "masilgasil-prod-ecs-container",
      "image": "637423336854.dkr.ecr.ap-northeast-2.amazonaws.com/masilgasil-ecr",
      "cpu": 0,
      "portMappings": [
        {
          "name": "masilgasil-prod-ecs-service-port",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
